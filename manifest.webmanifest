{
  "name": "Nts",
  "short_name": "Nts",
  "description": "Kendine attığın link, not ve dosyaları topla, düzenle, sor.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "lang": "tr",
  "dir": "auto",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "display": "standalone",
  "background_color": "#0c0c0e",
  "theme_color": "#0c0c0e",
  "categories": [
    "productivity",
    "utilities"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*",
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            "text/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Yeni not",
      "short_name": "Yeni not",
      "url": "./?do=new",
      "icons": [
        {
          "src": "icons/sc-note.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ara",
      "short_name": "Ara",
      "url": "./?do=find",
      "icons": [
        {
          "src": "icons/sc-find.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Yapılacaklar",
      "short_name": "Yapılacaklar",
      "url": "./?view=todo",
      "icons": [
        {
          "src": "icons/sc-todo.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Şifrelerim",
      "short_name": "Şifrelerim",
      "url": "./?do=vault",
      "icons": [
        {
          "src": "icons/sc-lock.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
